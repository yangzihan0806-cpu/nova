# Optional: key for the AI Planner on /new.html. Copy this file to .env (never commit .env).
# Without a key the planner returns 503 and the normal job form still works.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
OPENROUTER_MODEL=openai/gpt-4o
# Alternatively set ANTHROPIC_API_KEY (and optionally TG_PLANNER_MODEL); it takes precedence.
